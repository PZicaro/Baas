# Aplicação
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Banco de dados (MySQL)
# Se for usar o MySQL do docker-compose rodando a API fora do Docker
# (ex.: npm run start:dev), use DB_PORT=3307 (veja docker-compose.yml).
# Se estiver usando um MySQL já instalado localmente, mantenha 3306 e
# ajuste usuário/senha conforme sua instalação.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=baas_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Autenticação (JWT) — sessão via cookie httpOnly, ver README
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Gateway de pagamento (Lera Box)
GATEWAY_BASE_URL=https://api.branchpay.com.br/api
# Chave usada para cifrar a senha do gateway armazenada em gateway_accounts.
# Se omitida, cai para JWT_SECRET — em produção, use uma chave própria.
GATEWAY_ENCRYPTION_KEY=change-me-in-production

# Logging
LOG_LEVEL=info
